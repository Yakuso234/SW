# 复制为 .env 后再填写本机开发凭据；不要提交真实 .env。
# Compose 项目名用于隔离 SW 的容器、网络和数据卷，避免和其他项目冲突。
COMPOSE_PROJECT_NAME=sw-dev
SW_MYSQL_HOST=localhost
SW_MYSQL_PORT=13306
SW_REDIS_HOST=localhost
SW_REDIS_PORT=16379
SW_RABBITMQ_HOST=localhost
SW_RABBITMQ_PORT=25672
SW_RABBITMQ_MANAGEMENT_PORT=25673
SW_MINIO_HOST=localhost
SW_MINIO_PORT=29000
SW_MINIO_CONSOLE_PORT=29001
SW_NACOS_HOST=localhost
SW_NACOS_PORT=28848
SW_NACOS_GRPC_PORT=29848
SW_NACOS_SERVER_ADDR=localhost:28848
MYSQL_USERNAME=sw_local
MYSQL_ROOT_PASSWORD=change_me_mysql_password
MYSQL_PASSWORD=change_me_mysql_user_password
REDIS_PASSWORD=change_me_redis_password
MQ_USERNAME=sw_local
MQ_PASSWORD=change_me_mq_password
MINIO_ACCESS_KEY=sw_local_minio
MINIO_SECRET_KEY=change_me_minio_secret
NACOS_USERNAME=nacos
NACOS_PASSWORD=change_me_nacos_password
XXL_JOB_ACCESS_TOKEN=change_me_xxl_job_token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
